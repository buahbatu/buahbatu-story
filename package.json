{
  "name": "buahbatu-story",
  "private": true,
  "version": "0.0.0",
  "description": "Life-sim pixel 2D berdua berlatar Bandung",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run src/content/content.test.ts",
    "doctor": "node scripts/doctor.ts",
    "tools": "node scripts/tools.ts",
    "prepare": "node scripts/hooks.ts",
    "setup": "node scripts/setup.ts",
    "build:test": "vite build --mode test --outDir dist-test",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "easystarjs": "^0.4.4",
    "idb-keyval": "^6.3.0",
    "immer": "^11.2.10",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
