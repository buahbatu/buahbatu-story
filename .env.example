# ============================================================
# Buahbatu Story · template env  (salin jadi .env.local)
# Detail: docs/51-otomasi-akun-env.md
# JANGAN commit .env.local. JANGAN tempel isinya di chat.
# ============================================================

# ---------- 🔑 DIISI USER ----------
# GitHub (GH_TOKEN opsional: di perangkat ini token diambil dari keyring gh akun buahbatu, lihat ADR-014)
GIT_USER_NAME=
GIT_USER_EMAIL=
GH_TOKEN=
GH_OWNER=                      # username/org GitHub tempat repo dibuat

# Vercel
VERCEL_TOKEN=
VERCEL_SCOPE=                  # opsional: slug team

# Supabase
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=               # opsional: AI bisa cari sendiri

# TURN (voice chat, baru dibutuhkan mulai fase P11)
METERED_APP_NAME=
METERED_API_KEY=

# ---------- 🤖 DIISI OTOMATIS OLEH `npm run setup` ----------
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
CRON_SECRET=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Akun khusus tes E2E (dibuat otomatis)
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
