# ============================================================
# Buahbatu Story · template env  (salin jadi .env.local)
# Detail & cara membuat token: docs/51-otomasi-akun-env.md §4
#
# JANGAN commit .env.local. JANGAN tempel isinya di chat.
# 🔒 = rahasia (jangan pernah ke browser/log)   🌐 = publik (boleh ter-bundle ke browser)
# Variabel berawalan VITE_ IKUT ter-bundle ke browser → jangan pernah taruh rahasia di sana.
# ============================================================

# ---------- 🔑 DIISI USER ----------
# GitHub. GH_TOKEN opsional: di perangkat ini token diambil dari keyring gh akun proyek (ADR-014).
GIT_USER_NAME=
GIT_USER_EMAIL=
# 🔒 Personal access token (repo, workflow)
GH_TOKEN=
# Username/org GitHub pemilik repo
GH_OWNER=

# Vercel
# 🔒
VERCEL_TOKEN=
# Opsional: slug team Vercel
VERCEL_SCOPE=

# Supabase
# 🔒 Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# Opsional: AI bisa mencarinya sendiri (supabase orgs list)
SUPABASE_ORG_ID=

# TURN untuk voice chat (baru dibutuhkan mulai fase P11)
METERED_APP_NAME=
# 🔒
METERED_API_KEY=

# ---------- 🤖 DIISI OTOMATIS OLEH `npm run setup` ----------
SUPABASE_PROJECT_REF=
# 🔒 di-generate acak
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
# 🔒 HANYA untuk api/ & scripts/ (dicegah ESLint di kode client)
SUPABASE_SERVICE_ROLE_KEY=
# 🌐
VITE_SUPABASE_URL=
# 🌐 anon/publishable key, aman di browser karena dilindungi RLS
VITE_SUPABASE_ANON_KEY=
# 🔒 di-generate acak, dipakai Vercel Cron keep-alive (P5-08)
CRON_SECRET=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Akun khusus tes E2E (dibuat otomatis, P5-10)
TEST_A_EMAIL=
# 🔒
TEST_A_PASSWORD=
TEST_B_EMAIL=
# 🔒
TEST_B_PASSWORD=
